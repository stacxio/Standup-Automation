# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789                    # check-in channel; also the summary fallback
SLACK_INCLUDE_THREADS=true

# Route the daily summary by issue-key prefix. Prefix:channel_id, comma-separated;
# several prefixes may share a channel. Any prefix not listed here (and any
# developer with no task) falls back to SLACK_CHANNEL_ID. The bot must be a
# member of every channel listed. Leave blank to post everything to the default.
SUMMARY_CHANNEL_ROUTES=SP:C0AAAAAAA,WS:C0AAAAAAA,HIR:C0BBBBBBB,BHA:C0CCCCCCC
# Developer -> channel, by roster short name. Takes precedence over the prefix
# routes above: some people report to one team's channel whatever the issue-key
# prefix says, and it keeps a task-less developer out of the check-in fallback.
SUMMARY_DEVELOPER_ROUTES=Sahil:C0AAAAAAA,Gokul:C0BBBBBBB

# --- Reasoning engine ---
# backend: hosted | local
REASONING_BACKEND=local
REASONING_MODEL=qwen3:30b-a3b
REASONING_BASE_URL=http://localhost:11434/v1   # for local (Ollama/vLLM); ignored for hosted
REASONING_API_KEY=                              # for hosted backends
REASONING_MAX_RETRIES=3

# --- Jira (optional; enables the Completed Tasks column) ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=                                 # id.atlassian.com/manage-profile/security/api-tokens

# --- Google Sheets ---
GOOGLE_SA_KEY_PATH=credentials/service-account.json
SPREADSHEET_ID=
SHEET_TAB_NAME=master-log

# --- Otter (source for the meeting archive agent) ---
# backend: official | web
#   official = Otter Public API (Bearer key). Enterprise workspaces only — ask your
#              Otter account manager to enable it, then create the key under
#              Integrations -> Developer -> Create key.
#   web      = the internal API the otter.ai web app itself calls, driven with your
#              account email/password. Works on any plan, but it is UNOFFICIAL and
#              Otter can change or block it without notice.
# Leave these unset and run `archive_meetings.py --inbox DIR` to archive Otter files
# you exported by hand — no login at all, and it cannot break.
OTTER_BACKEND=official
OTTER_API_KEY=                                  # official backend
OTTER_WORKSPACE_ID=                             # optional; else discovered via GET /workspace
OTTER_EMAIL=                                    # web backend only
OTTER_PASSWORD=                                 # web backend only
OTTER_API_BASE=https://api.otter.ai/v1          # override if Otter moves an endpoint
OTTER_WEB_BASE=https://otter.ai/forward/api/v1

# --- Meeting archive (Google Drive) ---
DRIVE_ARCHIVE_FOLDER=Meeting Archive            # created in your Drive on first run
DRIVE_ARCHIVE_FOLDER_ID=                        # optional: pin to an existing shared folder id
# Map issue-key prefix -> archive project folder. Several prefixes may share one
# folder, exactly like SUMMARY_CHANNEL_ROUTES shares a channel. A meeting that
# names no listed prefix is filed under ARCHIVE_DEFAULT_PROJECT.
ARCHIVE_PROJECT_NAMES=SP:STACX,WS:STACX,HIR:HIROCOM,BHA:BHA
ARCHIVE_DEFAULT_PROJECT=General
ARCHIVE_KEEP_AUDIO=true                         # false = transcripts/summaries only, no media

# --- Daily performance scoring (docs/SCORING.md) ---
# The six weights MUST sum to 100 — the scorer refuses to run otherwise, so a
# typo here fails loudly instead of quietly scoring everyone out of 95.
SCORE_WEIGHT_CHECKIN=10                         # check-in posted in the check-in channel
SCORE_WEIGHT_PICKED=5                           # a task id was mentioned
SCORE_WEIGHT_DESCRIPTION=10                     # the Jira ticket is documented
SCORE_WEIGHT_COMMIT=5                           # branch/commit/PR linked in the dev panel
SCORE_WEIGHT_COMMENT=10                         # their own comment on the task, that day
SCORE_WEIGHT_DONE=60                            # task Done, or In Review with a commit id

SCORE_CAPTURE_HOUR=11                           # freeze the day's committed tasks
SCORE_CUTOFF_HOUR=18                            # score against Jira state at this hour
SCORE_RECOMPUTE_DAYS=3                          # nightly self-correcting window

SCORE_MIN_DESCRIPTION_CHARS=30                  # below this, "fix" would score full marks
SCORE_MIN_COMMENT_CHARS=20                      # below this, "ok" would score full marks
SCORE_REVIEW_STATUSES=In Review,Code Review,Review
SCORE_INCIDENT_TYPES=Incident,Support           # unplanned work: process-only, rescaled
SCORE_INCIDENT_PROJECTS=                        # optional issue-key prefixes, same effect
SCORE_MIN_MEDIAN_TASKS=2                        # under-commitment guard stays off below this
SCORE_PROJECT_PREFIXES=                         # blank = derive from SUMMARY_CHANNEL_ROUTES +
                                                # ARCHIVE_PROJECT_NAMES. Stand-up prose throws off
                                                # keys like "ST-11"/"ORG-404" that aren't issues.

# Adjustments for how this team actually uses Jira (see docs/SCORING.md §4).
SCORE_PARENT_DESCRIPTION=true                   # a sub-task inherits its parent's description
SCORE_MEDIA_IS_COMMENT=true                     # a screenshot-only comment counts as an update
SCORE_COMMIT_IN_COMMENT=true                    # a commit id in a comment counts (no SCM linked)

# Delivery credit per task state. Binary done/not-done pays nothing for work
# sitting in review, which is where most in-flight work is at a 6pm cutoff.
SCORE_CREDIT_DONE=1.0
SCORE_CREDIT_REVIEW_COMMIT=1.0                  # in review WITH a commit id
SCORE_CREDIT_REVIEW=0.5                         # in review without one
SCORE_CREDIT_IN_PROGRESS=0.25
SCORE_CREDIT_TODO=0.0

SCORE_OPS_CHANNEL_ID=                           # where 'Not Scored' data failures are reported
SCORE_POST_CHANNELS=                            # channels the daily scorecard posts to,
                                                # comma-separated. Blank = SLACK_CHANNEL_ID only.
SCORE_PUBLIC_SCORES=true                        # post every developer's score to SLACK_CHANNEL_ID
SCORE_PUBLIC_ORDER=roster                       # roster = roll-call order | score = highest first
SCORE_DM_ENABLED=false                          # also DM each person their evidence breakdown
SCORE_NUDGE_ENABLED=true                        # at SCORE_CAPTURE_HOUR, DM anyone who has
                                                # named no ticket id yet, while the day can
                                                # still be fixed
                                                # set PUBLIC_SCORES=false too during shadow mode

# --- Schedule / run window ---
TIMEZONE=Asia/Colombo
RUN_WINDOW=today                                # window definition
EXPECTED_MEMBERS=                               # optional, comma-separated names
