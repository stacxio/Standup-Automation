# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789                    # check-in channel; also the summary fallback
SLACK_INCLUDE_THREADS=true

# Route the daily summary by issue-key prefix. Prefix:channel_id, comma-separated;
# several prefixes may share a channel. Any prefix not listed here (and any
# developer with no task) falls back to SLACK_CHANNEL_ID. The bot must be a
# member of every channel listed. Leave blank to post everything to the default.
SUMMARY_CHANNEL_ROUTES=SP:C0AAAAAAA,WS:C0AAAAAAA,HIR:C0BBBBBBB,BHA:C0CCCCCCC

# --- Reasoning engine ---
# backend: hosted | local
REASONING_BACKEND=local
REASONING_MODEL=qwen3:30b-a3b
REASONING_BASE_URL=http://localhost:11434/v1   # for local (Ollama/vLLM); ignored for hosted
REASONING_API_KEY=                              # for hosted backends
REASONING_MAX_RETRIES=3

# --- Jira (optional; enables the Completed Tasks column) ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=                                 # id.atlassian.com/manage-profile/security/api-tokens

# --- Google Sheets ---
GOOGLE_SA_KEY_PATH=credentials/service-account.json
SPREADSHEET_ID=
SHEET_TAB_NAME=master-log

# --- Otter (source for the meeting archive agent) ---
# backend: official | web
#   official = Otter Public API (Bearer key). Enterprise workspaces only — ask your
#              Otter account manager to enable it, then create the key under
#              Integrations -> Developer -> Create key.
#   web      = the internal API the otter.ai web app itself calls, driven with your
#              account email/password. Works on any plan, but it is UNOFFICIAL and
#              Otter can change or block it without notice.
# Leave these unset and run `archive_meetings.py --inbox DIR` to archive Otter files
# you exported by hand — no login at all, and it cannot break.
OTTER_BACKEND=official
OTTER_API_KEY=                                  # official backend
OTTER_WORKSPACE_ID=                             # optional; else discovered via GET /workspace
OTTER_EMAIL=                                    # web backend only
OTTER_PASSWORD=                                 # web backend only
OTTER_API_BASE=https://api.otter.ai/v1          # override if Otter moves an endpoint
OTTER_WEB_BASE=https://otter.ai/forward/api/v1

# --- Meeting archive (Google Drive) ---
DRIVE_ARCHIVE_FOLDER=Meeting Archive            # created in your Drive on first run
DRIVE_ARCHIVE_FOLDER_ID=                        # optional: pin to an existing shared folder id
# Map issue-key prefix -> archive project folder. Several prefixes may share one
# folder, exactly like SUMMARY_CHANNEL_ROUTES shares a channel. A meeting that
# names no listed prefix is filed under ARCHIVE_DEFAULT_PROJECT.
ARCHIVE_PROJECT_NAMES=SP:STACX,WS:STACX,HIR:HIROCOM,BHA:BHA
ARCHIVE_DEFAULT_PROJECT=General
ARCHIVE_KEEP_AUDIO=true                         # false = transcripts/summaries only, no media

# --- Schedule / run window ---
TIMEZONE=Asia/Colombo
RUN_WINDOW=today                                # window definition
EXPECTED_MEMBERS=                               # optional, comma-separated names
